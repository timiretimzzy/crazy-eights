# ---------------------------------------------------------------------------
# Frontend-safe credentials (public, baked into the Vite bundle).
#
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are REQUIRED for online
# multiplayer (create/interact with lobbies). Without them the app still runs,
# but only local solo-vs-AI is available.
#
# Copy this file to `.env.local` and fill in the real values.
# The ANON KEY is safe for browsers. NEVER prefix the service-role key with
# VITE_ or put it in this file / any client code / GitHub Pages / Vercel env.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---------------------------------------------------------------------------
# Server-only credentials (used by Supabase Edge Functions via their own
# built-in environment; NOT available to the browser build).
#
# These are injected by the Supabase platform automatically as:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# Do NOT create VITE_SUPABASE_SERVICE_ROLE_KEY anywhere.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=NEVER_PUT_THIS_IN_FRONTEND_CODE